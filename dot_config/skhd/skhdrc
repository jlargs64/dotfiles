# =============================================================================
# skhd — hotkey daemon driving yabai.
#
# Managed by chezmoi. Reload after editing:  skhd --restart-service
# skhd needs Accessibility permission:
#   System Settings > Privacy & Security > Accessibility > /opt/homebrew/bin/skhd
#
# Modifier convention:
#   alt         - focus / query
#   shift + alt - move / mutate
# =============================================================================

# ----- focus window ---------------------------------------------------------
alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east

# ----- move window within the tree -----------------------------------------
shift + alt - h : yabai -m window --warp west
shift + alt - j : yabai -m window --warp south
shift + alt - k : yabai -m window --warp north
shift + alt - l : yabai -m window --warp east

# ----- resize (grow toward, then shrink for the opposite edge) -------------
ctrl + alt - h : yabai -m window --resize left:-40:0  || yabai -m window --resize right:-40:0
ctrl + alt - l : yabai -m window --resize right:40:0  || yabai -m window --resize left:40:0
ctrl + alt - j : yabai -m window --resize bottom:0:40 || yabai -m window --resize top:0:40
ctrl + alt - k : yabai -m window --resize top:0:-40   || yabai -m window --resize bottom:0:-40

# ----- layout ---------------------------------------------------------------
alt - e          : yabai -m space --balance
alt - r          : yabai -m space --rotate 90
alt - t          : yabai -m window --toggle float --grid 4:4:1:1:2:2
alt - f          : yabai -m window --toggle zoom-fullscreen
shift + alt - f  : yabai -m window --toggle native-fullscreen
alt - m          : yabai -m window --toggle split

# ----- stacking ---------------------------------------------------------------
# A "stack" puts several windows in one tile, like browser tabs -- only the
# focused one is visible. All of this works without the scripting addition.
alt - s          : yabai -m space --layout "$(test "$(yabai -m query --spaces --space | jq -r .type)" = bsp && echo stack || echo bsp)"
alt - 0x21       : yabai -m window --focus stack.prev    # alt - [
alt - 0x1E       : yabai -m window --focus stack.next    # alt - ]

# Where the NEXT new window lands relative to the focused one.
shift + alt - s  : yabai -m window --insert stack        # stack onto this window
shift + alt - e  : yabai -m window --insert east         # split to the right
shift + alt - d  : yabai -m window --insert south        # split below

# ----- theme ----------------------------------------------------------------
# Cycle Ghostty + Zellij + Neovim + SketchyBar + borders + wallpaper together.
shift + alt - t : ~/.local/bin/theme-next
# Cycle the BACKGROUND within the current theme (retro-82 ships 9, catppuccin 3).
shift + alt - b : ~/.local/bin/theme-bg next

# ----- restart services -----------------------------------------------------
shift + alt - r : yabai --restart-service && sketchybar --reload

# ----- NOTE on spaces -------------------------------------------------------
# Switching and moving windows between spaces needs yabai's scripting addition
# (which requires partially disabling SIP) and is intentionally not configured.
# Use the native macOS shortcuts instead:
#   ctrl - <number>      switch to desktop N   (System Settings > Keyboard)
#   ctrl - left / right  switch desktop
