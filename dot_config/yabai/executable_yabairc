#!/usr/bin/env bash
# =============================================================================
# yabai — tiling window manager, layered on top of NATIVE macOS Spaces.
#
# The scripting addition is deliberately NOT loaded. It requires partially
# disabling SIP, which this setup does not do. Everything below works without
# it. What you give up without the scripting addition:
#   * creating / destroying spaces from yabai  (use Mission Control)
#   * moving a window to another space via yabai (use native drag, or
#     System Settings > Keyboard shortcuts)
#   * window shadows/opacity toggles on some macOS versions
# Tiling, resizing, focus and layout all work fine without it.
#
# Managed by chezmoi. Restart after editing:  yabai --restart-service
# =============================================================================

# ----- global layout --------------------------------------------------------
yabai -m config layout                      bsp
yabai -m config window_placement            second_child
yabai -m config auto_balance                off
yabai -m config split_ratio                 0.50

# ----- gaps and padding -----------------------------------------------------
# top_padding leaves room for the SketchyBar bar (height 38 + y_offset 4).
yabai -m config top_padding                 48
yabai -m config bottom_padding              8
yabai -m config left_padding                8
yabai -m config right_padding               8
yabai -m config window_gap                  8

# ----- focus behaviour ------------------------------------------------------
yabai -m config mouse_follows_focus          off
yabai -m config focus_follows_mouse          off
yabai -m config window_topmost               off
yabai -m config window_shadow                float

# ----- mouse ----------------------------------------------------------------
# alt + left-drag  = move window, alt + right-drag = resize window
yabai -m config mouse_modifier               alt
yabai -m config mouse_action1                move
yabai -m config mouse_action2                resize
yabai -m config mouse_drop_action            swap

# ----- borders are drawn by JankyBorders, not yabai -------------------------
yabai -m config window_border                off

# ----- keep SketchyBar's space indicators in sync ---------------------------
# Without the scripting addition yabai cannot emit space_change itself, so we
# mirror window lifecycle events into a custom SketchyBar event.
yabai -m signal --add event=window_created   action="sketchybar --trigger yabai_window_change"
yabai -m signal --add event=window_destroyed action="sketchybar --trigger yabai_window_change"
yabai -m signal --add event=window_focused   action="sketchybar --trigger yabai_window_change"
yabai -m signal --add event=space_changed    action="sketchybar --trigger yabai_window_change"

# ----- rules: apps that should never be tiled -------------------------------
yabai -m rule --add app="^System Settings$"        manage=off
yabai -m rule --add app="^System Information$"     manage=off
yabai -m rule --add app="^Activity Monitor$"       manage=off
yabai -m rule --add app="^Calculator$"             manage=off
yabai -m rule --add app="^Archive Utility$"        manage=off
yabai -m rule --add app="^Finder$" title="^Copy$"  manage=off
yabai -m rule --add app="^1Password$"              manage=off
yabai -m rule --add app="^Raycast$"                manage=off

echo "yabai configuration loaded"
