# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
# font-family = Iosevka
# window-padding-x = 2
#
# # Spacing around the equals sign does not matter.
# # All of these are identical:
# key=value
# key= value
# key =value
# key = value
#
# # Any line beginning with a # is a comment. It's not possible to put
# # a comment after a config option, since it would be interpreted as a
# # part of the value. For example, this will have a value of "#123abc":
# background = #123abc
#
# # Empty values are used to reset config keys to default.
# key =
#
# # Some config options have unique syntaxes for their value,
# # which is explained in the docs for that config option.
# # Just for example:
# resize-overlay-duration = 4s 200ms

# Zellij: every new window/tab gets its OWN session, so windows never mirror
# each other. Attaching them all to one shared session (the previous
# `zellij attach -c main`) meant two windows showed the same panes.
# $$ is the launching zsh's PID, which keeps names unique if two windows
# open within the same second.
#   zellij list-sessions        see them all
#   zellij attach <name>        resume one after closing its window
#   zellij delete-all-sessions  clean up exited ones

# Vibes
# [theme-system] was: theme = Catppuccin Frappe
# font-family = FiraCode Nerd Font Mono
# [theme-system] was: font-family = JetBrains Mono

# Function

desktop-notifications = true
# [theme-system] was: macos-titlebar-style = transparent
shell-integration-features = sudo
#shell-integration-features = cursor,sudo,title
shell-integration-features = no-cursor,no-sudo,no-title
background-opacity = 1.0

mouse-scroll-multiplier = 0.5

# Window
window-decoration = true
# [theme-system] was: window-padding-x = 8
# [theme-system] was: window-padding-y = 8

# Vim-like pane navigation (cmd+shift = thumb+pinky)
keybind = cmd+shift+h=goto_split:left
keybind = cmd+shift+j=goto_split:down
keybind = cmd+shift+k=goto_split:up
keybind = cmd+shift+l=goto_split:right

# Vim-like pane resize (ctrl+shift = thumb+pinky)
keybind = ctrl+shift+h=resize_split:left,10
keybind = ctrl+shift+j=resize_split:down,10
keybind = ctrl+shift+k=resize_split:up,10
keybind = ctrl+shift+l=resize_split:right,10

# Splits
keybind = cmd+shift+s=new_split:down
keybind = cmd+shift+v=new_split:right

# ===== omarchy-style theme system (managed) =====
font-family = JetBrainsMono Nerd Font
font-size = 14
window-padding-x = 8
window-padding-y = 8
# `hidden` disables native tabs: new_tab opens a new window instead.
macos-titlebar-style = tabs
keybind = cmd+shift+comma=reload_config

# Theme fragment. The leading `?` makes it optional, so Ghostty still starts
# if ~/.config/theme/current is missing.
config-file = ?~/.config/theme/current/ghostty
# ===== end theme system =====

# ---- Zellij-style modes as Ghostty key tables (1.3+) ----------------------
# Direct keys (zellij shared_except locked)
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:right
keybind = alt+n=new_split:right
keybind = alt+f=toggle_quick_terminal
keybind = ctrl+g=deactivate_all_key_tables
keybind = ctrl+o=toggle_command_palette

# ctrl+p  pane mode (one-shot)
keybind = ctrl+p=activate_key_table_once:pane
keybind = pane/h=goto_split:left
keybind = pane/j=goto_split:down
keybind = pane/k=goto_split:up
keybind = pane/l=goto_split:right
keybind = pane/p=goto_split:previous
keybind = pane/n=new_split:right
keybind = pane/r=new_split:right
keybind = pane/d=new_split:down
keybind = pane/x=close_surface
keybind = pane/f=toggle_split_zoom
keybind = pane/c=prompt_surface_title
keybind = pane/w=toggle_quick_terminal
keybind = pane/escape=deactivate_key_table
keybind = pane/ctrl+p=deactivate_key_table

# ctrl+t  tab mode (one-shot)
keybind = ctrl+t=activate_key_table_once:tab
keybind = tab/h=previous_tab
keybind = tab/k=previous_tab
keybind = tab/j=next_tab
keybind = tab/l=next_tab
keybind = tab/n=new_tab
keybind = tab/x=close_tab
keybind = tab/r=prompt_tab_title
keybind = tab/tab=last_tab
keybind = tab/bracket_left=move_tab:-1
keybind = tab/bracket_right=move_tab:1
keybind = tab/one=goto_tab:1
keybind = tab/two=goto_tab:2
keybind = tab/three=goto_tab:3
keybind = tab/four=goto_tab:4
keybind = tab/five=goto_tab:5
keybind = tab/six=goto_tab:6
keybind = tab/seven=goto_tab:7
keybind = tab/eight=goto_tab:8
keybind = tab/nine=goto_tab:9
keybind = tab/escape=deactivate_key_table
keybind = tab/ctrl+t=deactivate_key_table

# ctrl+n  resize mode (sticky; esc/enter/ctrl+n to leave)
keybind = ctrl+n=activate_key_table:resize
keybind = resize/h=resize_split:left,40
keybind = resize/j=resize_split:down,40
keybind = resize/k=resize_split:up,40
keybind = resize/l=resize_split:right,40
keybind = resize/zero=equalize_splits
keybind = resize/escape=deactivate_key_table
keybind = resize/enter=deactivate_key_table
keybind = resize/ctrl+n=deactivate_key_table

# ctrl+s  scroll mode (sticky; esc/ctrl+s/ctrl+c to leave)
keybind = ctrl+s=activate_key_table:scroll
keybind = scroll/j=scroll_page_lines:1
keybind = scroll/k=scroll_page_lines:-1
keybind = scroll/d=scroll_page_fractional:0.5
keybind = scroll/u=scroll_page_fractional:-0.5
keybind = scroll/ctrl+f=scroll_page_down
keybind = scroll/ctrl+b=scroll_page_up
keybind = scroll/l=scroll_page_down
keybind = scroll/h=scroll_page_up
keybind = scroll/bracket_left=jump_to_prompt:-1
keybind = scroll/bracket_right=jump_to_prompt:1
keybind = scroll/g=scroll_to_top
keybind = scroll/shift+g=scroll_to_bottom
keybind = scroll/s=start_search
keybind = scroll/e=text:nvim 
keybind = chain=write_scrollback_file:paste
keybind = chain=text:\r
keybind = chain=deactivate_key_table
keybind = scroll/ctrl+c=scroll_to_bottom
keybind = chain=deactivate_key_table
keybind = scroll/escape=deactivate_key_table
keybind = scroll/ctrl+s=deactivate_key_table

# ctrl+b  tmux-compat prefix (one-shot)
keybind = ctrl+b=activate_key_table_once:tmux
keybind = tmux/ctrl+b=text:\x02
keybind = tmux/shift+apostrophe=new_split:down
keybind = tmux/shift+five=new_split:right
keybind = tmux/o=goto_split:next
keybind = tmux/semicolon=goto_split:previous
keybind = tmux/x=close_surface
keybind = tmux/z=toggle_split_zoom
keybind = tmux/c=new_tab
keybind = tmux/n=next_tab
keybind = tmux/p=previous_tab
keybind = tmux/l=last_tab
keybind = tmux/shift+seven=close_tab
keybind = tmux/comma=prompt_tab_title
keybind = tmux/w=toggle_tab_overview
keybind = tmux/one=goto_tab:1
keybind = tmux/two=goto_tab:2
keybind = tmux/three=goto_tab:3
keybind = tmux/four=goto_tab:4
keybind = tmux/five=goto_tab:5
keybind = tmux/six=goto_tab:6
keybind = tmux/seven=goto_tab:7
keybind = tmux/eight=goto_tab:8
keybind = tmux/nine=goto_tab:9
keybind = tmux/escape=deactivate_key_table
