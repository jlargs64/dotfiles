{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash

set -e

echo "Installing macOS packages..."

# Install Homebrew if not installed
if ! command -v brew &>/dev/null; then
  echo "Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Update Homebrew
echo "Updating Homebrew..."
brew update

# Install packages
echo "Installing packages..."
brew install \
  uv \
  zellij \
  eza \
  starship \
  fd \
  ripgrep \
  fzf \
  bat \
  git-delta \
  neovim \
  mise \
  jq \
  imagemagick

# ---------------------------------------------------------------------------
# Desktop stack: tiling window manager, status bar, window borders, hotkeys.
# See docs/window-management.md and docs/theme-system.md.
#
#   yabai      tiling WM, layered over native macOS Spaces
#   skhd       hotkey daemon that drives yabai and the theme switcher
#   sketchybar status bar
#   borders    (JankyBorders) active-window border, themed
#
# jq and imagemagick above are not optional here: the SketchyBar space plugin
# parses yabai's JSON with jq, and theme-wallpaper renders wallpapers with
# ImageMagick.
# ---------------------------------------------------------------------------
echo "Installing desktop stack..."
brew install \
  koekeishiya/formulae/yabai \
  koekeishiya/formulae/skhd \
  FelixKratz/formulae/sketchybar \
  FelixKratz/formulae/borders

# Fonts. JetBrainsMono Nerd Font is what the theme system sets Ghostty to;
# Hack Nerd Font is what SketchyBar's item fonts reference.
echo "Installing fonts..."
brew install --cask \
  font-jetbrains-mono-nerd-font \
  font-hack-nerd-font

# sketchybar-app-font provides the per-app glyphs in the Space indicators.
# Pinned release + sha256, so a moved tag or a tampered asset is refused
# instead of installed. To bump: update both the URL and the hash.
FONT_URL="https://github.com/kvndrsslr/sketchybar-app-font/releases/download/v2.0.28/sketchybar-app-font.ttf"
FONT_SHA256="e49ee3281aca67634c2e7c0261d898226149664e9842b7fe61af8c4726d1f1de"
FONT_DEST="$HOME/Library/Fonts/sketchybar-app-font.ttf"
if [ ! -f "$FONT_DEST" ]; then
  echo "Installing sketchybar-app-font..."
  font_tmp="$(mktemp -t sketchybar-app-font)"
  if curl -fsSL -o "$font_tmp" "$FONT_URL" \
     && echo "$FONT_SHA256  $font_tmp" | shasum -a 256 -c --status; then
    mv "$font_tmp" "$FONT_DEST"
  else
    rm -f "$font_tmp"
    echo "  (download failed or checksum mismatch; bar will render app icons as blanks)"
  fi
fi

echo "Cleanup..."
brew cleanup

cat <<'NOTICE'

macOS packages installed successfully!

MANUAL STEP REQUIRED -- yabai and skhd cannot start without it:

  1. System Settings > Privacy & Security > Accessibility
     Add and enable BOTH:
       /opt/homebrew/bin/yabai
       /opt/homebrew/bin/skhd

  2. Then start the services:
       yabai --start-service
       skhd --start-service
       brew services start borders
       brew services start sketchybar

The yabai scripting addition is deliberately NOT used -- it requires partially
disabling SIP. Tiling works without it; switching Spaces stays native
(ctrl + <number>). See docs/window-management.md.

NOTICE
{{- end -}}
