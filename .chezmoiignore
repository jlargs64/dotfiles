# ---------------------------------------------------------------------------
# chezmoi ignore rules. Patterns are relative to the TARGET dir (~), not to
# this source repo.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Repo-only files. These document the repo; they are not configuration and must
# never be written into the home directory.
# ---------------------------------------------------------------------------
README.md
LICENSE
docs

# macarchy (github.com/jlargs64/macarchy) owns the desktop layer: theme system,
# yabai, skhd, SketchyBar, borders, raycast theme scripts and their ~/.local/bin
# links. It installs them as symlinks into its own checkout, so chezmoi must
# never write these paths or `chezmoi apply` would replace the symlinks with
# stale copies. Personal skhd bindings stay here in .config/skhd/local.skhdrc.
.config/theme
.config/theme/**
.config/sketchybar
.config/sketchybar/**
.config/borders
.config/borders/**
.config/yabai
.config/yabai/**
.config/raycast/scripts
.config/raycast/scripts/**
.config/macarchy
.config/macarchy/**
.config/skhd/skhdrc
.local/bin/theme-*
.local/bin/macarchy-*
.local/bin/hotkey-check
.local/bin/ws

# Backups left behind by installers and by zellij's own config rewrites.
**/*.bak
**/*.bak.[0-9]

# Real credentials, sourced from .zshrc line 29. This repo is PUBLIC, so this
# file must never enter it. Listed here so an accidental `chezmoi add -r ~`
# cannot pull it in; the tokens that used to sit inline in .zshrc now live
# here instead.
.secrets

# macOS-only window-manager and bar tooling.
{{- if ne .chezmoi.os "darwin" }}
.config/sketchybar
.config/borders
.config/skhd
.config/raycast
{{- end }}
